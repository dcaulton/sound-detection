FROM python:3.13-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /usr/local/bin/uv

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
COPY src ./src
COPY alembic.ini ./
COPY src/sound_detection/db/migrations ./src/sound_detection/db/migrations

# Dummy README so hatchling’s editable install doesn’t fail
RUN touch README.md

RUN uv pip install --system --no-cache \
      "fastapi>=0.115" \
      "uvicorn[standard]>=0.32" \
      "pydantic-settings>=2.5" \
      "sqlmodel>=0.0.22" \
      "psycopg[binary]>=3.2" \
      "asyncpg>=0.30" \
      "alembic>=1.13" \
      "structlog>=24.4" \
      "neo4j>=6.2.0" \
      "python-dotenv>=1.0" \
    && uv pip install --system --no-deps -e .

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn src.sound_detection.main:app --host 0.0.0.0 --port 8000"]